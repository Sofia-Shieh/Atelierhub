# 复制成 .env 后填真实值。.env 已在 .gitignore 里，不会被提交。

# ── HoyoWave 应用凭证 ──────────────────────────────────────────
HOYOWAVE_BASE_URL=https://open.hoyowave.com
HOYOWAVE_APP_ID=
HOYOWAVE_APP_SECRET=

# 回调加密与验签（HoyoWave 后台 → 应用设置 → 回调配置）
HOYOWAVE_AES_KEY=
HOYOWAVE_VERIFY_TOKEN=

# 可选：换 access_token 的路径若自动探测不中，在这里指定
# HOYOWAVE_TOKEN_URL=/openapi/auth/v1/access_token
# 可选：收件人 ID 类型，默认 user_id
# HOYOWAVE_RECEIVER_ID_TYPE=user_id

# ── 票据收集本地存储 ───────────────────────────────────────────
INVOICE_DB=invoice_collect.db
INVOICE_DIR=invoices

# ── 智能填充（可选，没有也能用本地规则解析）────────────────────
ANTHROPIC_API_KEY=
